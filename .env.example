# Plantilla de variables de entorno. Copia este archivo a `.env` y completa los valores.
# cp .env.example .env

# URL base del backend (sin slash final), incluido su prefijo global `/api`.
# El backend corre en el 3000; el 3002 es este mismo frontend (Vite).
# Default si no se define: /api
VITE_API_URL=http://localhost:3000/api

# Producción (Netlify). Vite incrusta la URL al compilar: en Netlify va como
# variable de entorno del sitio (Site configuration → Environment variables),
# disponible en el build, no en este archivo.
# VITE_API_URL=https://api.citiahealth.cl/api
