# Plantilla de variables de entorno. Copia este archivo a `.env` y completa los valores.
# cp .env.example .env

# URL base del backend (sin slash final), incluido su prefijo global `/api`.
# El backend corre en el 3000; el 3002 es este mismo frontend (Vite).
# Default si no se define: /api
VITE_API_URL=http://localhost:3000/api
