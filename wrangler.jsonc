// Despliegue del frontend en Cloudflare Workers (Static Assets). Sin código de
// Worker: Cloudflare sirve el `dist/` que genera `npm run build`.
//
//   npm run build && npx wrangler deploy
//
// `wrangler` no es dependencia del proyecto: se usa con `npx` (o lo corre
// Cloudflare Workers Builds al conectar el repositorio).
//
// OJO con `VITE_API_URL`: Vite la incrusta AL COMPILAR, no al servir. En
// Workers Builds va como variable de BUILD (no como `vars` del Worker):
//   VITE_API_URL=https://api.citiahealth.cl/api
{
  "name": "citia-frontend",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // SPA: una ruta que no es un archivo (/agenda, /recordatorios,
    // /agendar-cita/<slug>) devuelve index.html con 200 y la resuelve
    // vue-router. Sin esto, recargar cualquier ruta que no sea / da 404.
    "not_found_handling": "single-page-application"
  }
}
